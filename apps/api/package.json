{
  "name": "@vigilo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.0"
  }
}
